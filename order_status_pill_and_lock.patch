+            return ['Paid', ['bg' => '#dbeafe', 'text' => '#1e40af']];
+        }
+        if ($this->record->status === \App\Models\Order::PENDING) {
+            return ['Pending', ['bg' => '#fef3c7', 'text' => '#92400e']];
+        }
+        return [ucfirst($this->record->status ?? 'Unknown'), ['bg' => '#f3f4f6', 'text' => '#374151']];
