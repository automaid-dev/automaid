+            }
+            Schema::table('settings', function (Blueprint $table) use ($new) {
+                $table->decimal($new, 5, 2)->default(0);
+            });
+            $old = "{$gw}_service_charge_percent";
+            if (Schema::hasColumn('settings', $old)) {
+                DB::table('settings')->update([$new => DB::raw($old)]);
+            }
+        }
+    }
+
