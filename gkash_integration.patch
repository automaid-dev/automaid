diff --git a/app/Services/PaymentGateway/GkashPaymentService.php b/app/Services/PaymentGateway/GkashPaymentService.php
new file mode 100644
index 0000000..34b0496
--- /dev/null
+++ b/app/Services/PaymentGateway/GkashPaymentService.php
@@ -0,0 +1,154 @@
+<?php
+
+namespace App\Services\PaymentGateway;
+
+use Illuminate\Support\Facades\Http;
+use App\Contracts\PaymentGatewayInterface;
+
+class GkashPaymentService implements PaymentGatewayInterface
+{
+    protected $baseUrl;
+    protected $merchantId;
+    protected $signatureKey;
+    protected $environment;
+
+    public function __construct()
+    {
+        $this->baseUrl = config('services.gkash.base_url');
+        $this->merchantId = config('services.gkash.merchant_id');
+        $this->signatureKey = config('services.gkash.signature_key');
+        $this->environment = config('services.gkash.environment');
+    }
+
+    /**
+     * Builds the hosted checkout URL by calling GKash's payment/submit
+     * API — mirrors FiuuPaymentService::getPaymentUrl()'s $data shape
+     * exactly, so callers going through PaymentGatewayResolver don't
+     * need to know which gateway they ended up with.
+     *
+     * !! SIGNATURE ALGORITHM NOT INDEPENDENTLY VERIFIED !!
+     * See buildSignature() below before running this against GKash's
+     * real API for the first time.
+     *
+     * @param  array{orderid: string, amount: float|string, bill_name: string, bill_email: string, bill_mobile: string, bill_desc?: string, currency?: string} $data
+     * @return string
+     */
+    public function createPaymentUrl(array $data): string
+    {
+        $amount = number_format((float) $data['amount'], 2, '.', '');
+        $currency = $data['currency'] ?? 'MYR';
+
+        $payload = [
+            'merchant_id' => $this->merchantId,
+            'ref_no' => $data['orderid'],
+            'amount' => $amount,
+            'currency' => $currency,
+            'bill_name' => $data['bill_name'],
+            'bill_email' => $data['bill_email'],
+            'bill_mobile' => $data['bill_mobile'],
+            'description' => $data['bill_desc'] ?? 'Automaid Payment',
+            'return_url' => route('webhook.gkash.return'),
+            'callback_url' => route('webhook.gkash.notification'),
+        ];
+        $payload['signature'] = $this->buildSignature($payload);
+
+        $response = Http::asForm()->post($this->baseUrl . '/api/payment/submit', $payload);
+        $result = $response->json();
+
+        if (!$response->successful() || empty($result['payment_url'])) {
+            \Log::error('GkashPaymentService::createPaymentUrl failed', [
+                'payload' => $payload,
+                'response_status' => $response->status(),
+                'response_body' => $result,
+            ]);
+            throw new \Exception('Could not create GKash payment: ' . ($result['message'] ?? 'unknown error'));
+        }
+
+        return $result['payment_url'];
+    }
+
+    /**
+     * Independently verifies a GKash callback/return payload's
+     * signature before trusting its claimed status — never trust
+     * $data['status'] on its own.
+     *
+     * !! SIGNATURE ALGORITHM NOT INDEPENDENTLY VERIFIED !! — same
+     * caveat as buildSignature() below, since this re-derives the
+     * expected signature using the identical formula.
+     *
+     * @param  array<string, mixed> $data
+     * @return bool
+     */
+    public function verifyCallback(array $data): bool
+    {
+        if (empty($data['signature'])) {
+            return false;
+        }
+        $expected = $this->buildSignature($data);
+        return hash_equals($expected, (string) $data['signature']);
+    }
+
+    /**
+     * Query GKash directly for a transaction's current status — the
+     * server-to-server source of truth, same role Fiuu's checkPayment
+     * plays. Use this to confirm a payment rather than ever trusting a
+     * client-reported result alone.
+     *
+     * @param  string $refNo
+     * @return array<string, mixed>
+     */
+    public function queryTransactionStatus(string $refNo): array
+    {
+        $payload = [
+            'merchant_id' => $this->merchantId,
+            'ref_no' => $refNo,
+        ];
+        $payload['signature'] = $this->buildSignature($payload);
+
+        $response = Http::asForm()->post($this->baseUrl . '/api/payment/query', $payload);
+        return $response->json() ?? [];
+    }
+
+    /**
+     * !! NOT INDEPENDENTLY VERIFIED — CONFIRM BEFORE FIRST LIVE USE !!
+     *
+     * GKash's public documentation site (doc.gkash.my) is a JS
+     * single-page app that didn't render through automated fetching,
+     * and the underlying signature formula wasn't published anywhere
+     * else I could find (their own Laravel/Flutter SDKs hide it inside
+     * compiled/closed logic). What IS confirmed from GKash's own
+     * response samples and third-party SDK usage: field names
+     * (merchant_id, ref_no, amount, currency, signature), and that a
+     * changelog entry for the closest known integration explicitly
+     * mentions fixing a bug in "amount on signature generation" —
+     * confirming amount is part of whatever string gets hashed.
+     *
+     * This implementation is a best-effort reconstruction following
+     * the common pattern used across other Malaysian gateways
+     * (concatenate key fields in a fixed order + the merchant's
+     * private signature key, then MD5): merchant_id + ref_no + amount
+     * + currency + signature_key.
+     *
+     * Before going live: confirm this exact formula (field order,
+     * hash algorithm, uppercase/lowercase hex) against GKash's
+     * Merchant Onboarding Guideline (linked in the account welcome
+     * email) or via merchantsupport@gkash.com. Getting this wrong
+     * means every payment attempt fails signature verification at
+     * GKash's end (safe — no money moves) rather than silently
+     * succeeding with a wrong signature, so this is a "won't work
+     * until fixed" risk, not a security hole either way.
+     *
+     * @param  array<string, mixed> $data
+     * @return string
+     */
+    protected function buildSignature(array $data): string
+    {
+        $merchantId = $data['merchant_id'] ?? $this->merchantId;
+        $refNo = $data['ref_no'] ?? '';
+        $amount = $data['amount'] ?? '';
+        $currency = $data['currency'] ?? 'MYR';
+
+        $string = $merchantId . $refNo . $amount . $currency . $this->signatureKey;
+        return md5($string);
+    }
+}
