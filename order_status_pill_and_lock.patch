+            e($base) . ' <span style="display:inline-block;padding:2px 10px;border-radius:9999px;font-size:12px;font-weight:600;vertical-align:middle;background-color:' . $color['bg'] . ';color:' . $color['text'] . ';">' . e($label) . '</span>'
