index 222837d..de56deb 100755
--- a/app/Models/Payment.php
+++ b/app/Models/Payment.php
@@ -17,6 +17,7 @@ class Payment extends Model implements Auditable
 
     const FIUU = 'fiuu';
     const FIUU_RECURRING = 'fiuu-recurring';
+    const GKASH = 'gkash';
 
